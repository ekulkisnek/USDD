 *   publicValuesHash
 * ))
 * require(journal.hasNoBmmParentMtpField)
 * require(checked_abs_diff(
 *   currentBmmParentMtp.value,
 *   journal.provedExecutionBlockTimestamp
 * ) <= 21600)
 *
 * require(journal.priorState == current)
 * if journal.isMint:
 *   require(1 <= journal.depositCount && journal.depositCount <= 64)
 *   require(deposits_are_consecutive_from(journal, current.nextMintNonce))
 *   require(all_amounts_use_checked_usdt6_times_100(journal))
 *   require(each_deposit_usdt6 <= 20_000_000e6)
 *   require(batch_total_usdd8 <= 2_000_000_000_000_000)
 *   require(exact_native_usdd_reissuance_and_recipient_outputs(journal))
 * else if journal.isHeartbeat:
 *   require(journal.depositCount == 0)
 *   require(strictly_newer_finalized_ethereum_state(journal))
 *   require(nextMintNonce_and_totalMinted_unchanged(journal))
 *   require(zero_issuance_reissuance_and_usdd_outputs())
 * else fail
 * require(unique_successor_state_is_exact(journal.nextState))
 * require(all_reissuance_tokens_return_to_successor())
 * require(no_other_controller_successor())
 * succeed
 *
 * The SP1 verifier requires an upstream jet specification/CMR/generated
 * dispatch/type/cost/activation. It reads the bounded exact annex internally;
 * a generic annex-byte jet is deliberately not part of V1. Authenticated parent
 * MTP is exposed by generated decoder item 51; the future controller toolchain
